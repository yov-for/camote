{
  "entities": {
    "recommendation_logs": {
      "title": "Recommendation Analytics Logs",
      "description": "Logged searches, cravings, and recommendations for analytics and data review",
      "properties": {
        "sessionId": { "type": "string" },
        "selectedDishes": { "type": "array", "items": { "type": "string" } },
        "context": { "type": "object" },
        "location": { "type": "object" },
        "restrictions": { "type": "object" },
        "winnerRestaurant": { "type": "string" },
        "winnerDish": { "type": "string" },
        "diningMode": { "type": "string" },
        "priceRange": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "selectedDishes", "winnerRestaurant", "createdAt"]
    },
    "saved_favorites": {
      "title": "Saved User Recommendations",
      "description": "User saved/favorited options synced to cloud database",
      "properties": {
        "sessionId": { "type": "string" },
        "restaurantName": { "type": "string" },
        "dishHighlight": { "type": "string" },
        "category": { "type": "string" },
        "distrito": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "restaurantName", "dishHighlight", "savedAt"]
    }
  }
}
