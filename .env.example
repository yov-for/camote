# MONGODB_URI: Cadena de conexión a tu cluster de MongoDB Atlas (Plan M0 gratis)
MONGODB_URI="mongodb+srv://usuario:password@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority"

# GEMINI_API_KEY: Clave para llamadas a Google Gemini AI
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Puerto local del servidor (por defecto 3000)
PORT=3000
