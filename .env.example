# Plantilla de variables de entorno.
# Copia este archivo como ".env" y reemplaza el valor por el tuyo real.
# El ".env" NUNCA se sube a GitHub; este ".env.example" sí (no lleva valores).

# MONGODB_URI: cadena de conexión a tu cluster de MongoDB Atlas (plan M0 gratis).
# Es la ÚNICA variable que la aplicación necesita para funcionar.
# De dónde sale: Atlas -> Connect -> Drivers -> copiar la cadena, y reemplazar
# <password> por la contraseña real del usuario de base de datos.
MONGODB_URI="mongodb+srv://usuario:password@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority"
